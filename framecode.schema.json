{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "definitions": {
    "animation": {
      "type": "string",
      "enum": [
        "morph",
        "typewriter",
        "cascade"
      ],
      "default": "morph"
    },
    "stepConfig": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Filename to match (exact match)"
        },
        "animation": {
          "$ref": "#/definitions/animation",
          "description": "Animation style override for this step"
        },
        "charsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "description": "Characters per second for typewriter animation"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "description": "Logo source URL, data URL, or local file path"
        },
        "twitter": {
          "type": "string",
          "description": "Twitter/X handle watermark"
        },
        "website": {
          "type": "string",
          "description": "Website watermark"
        },
        "accent": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "description": "Brand accent color (#RGB or #RRGGBB)"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "theme": {
      "type": "string",
      "enum": [
        "vercel-dark",
        "story-gradients",
        "retro-terminal",
        "github-dark",
        "github-light",
        "nord",
        "dracula",
        "monokai",
        "tokyo-night",
        "catppuccin-mocha",
        "rose-pine",
        "synthwave-84",
        "material-theme-darker",
        "one-dark-pro",
        "vitesse-dark",
        "vitesse-light",
        "min-dark",
        "min-light",
        "night-owl",
        "ayu-dark",
        "gruvbox-dark-medium",
        "gruvbox-light-medium",
        "everforest-dark",
        "everforest-light",
        "kanagawa-wave",
        "rose-pine-moon",
        "rose-pine-dawn",
        "catppuccin-latte",
        "catppuccin-frappe",
        "catppuccin-macchiato",
        "github-dark-dimmed",
        "github-dark-high-contrast",
        "github-light-high-contrast",
        "dark-plus",
        "light-plus",
        "poimandres",
        "slack-dark",
        "one-light",
        "material-theme-lighter",
        "material-theme-ocean",
        "material-theme-palenight",
        "dracula-soft",
        "houston"
      ],
      "default": "vercel-dark"
    },
    "preset": {
      "type": "string",
      "enum": [
        "post",
        "tutorial",
        "square"
      ],
      "default": "tutorial"
    },
    "animation": {
      "$ref": "#/definitions/animation"
    },
    "charsPerSecond": {
      "type": "integer",
      "minimum": 1,
      "default": 30,
      "description": "Global characters per second for typewriter animation"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "default": 30
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "brand": {
      "$ref": "#/definitions/brand"
    },
    "stepConfigs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stepConfig"
      },
      "description": "Per-step animation configuration overrides"
    }
  },
  "additionalProperties": false
}
